{
  "name": "@pragmatiks/lint",
  "version": "0.7.0",
  "description": "Pragmatiks engineering principles eslint config and bundled semgrep rules.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint-config": {
      "types": "./dist/eslint-config/index.d.ts",
      "import": "./dist/eslint-config/index.js"
    },
    "./eslint-config/next": {
      "types": "./dist/eslint-config/next/index.d.ts",
      "import": "./dist/eslint-config/next/index.js"
    }
  },
  "files": [
    "dist",
    "src/semgrep-rules",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "format": "prettier --write .",
    "check": "eslint . && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/css-tree": "^4.0.5"
  },
  "peerDependencies": {
    "@eslint/css": "^2.0.0",
    "@tailwindcss/node": "~4.3.3",
    "@tailwindcss/postcss": "~4.3.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-x": "^5.20.8",
    "eslint-plugin-sonarjs": "^4.0.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "tailwindcss": "~4.3.3",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependenciesMeta": {
    "@eslint/css": {
      "optional": true
    },
    "@tailwindcss/node": {
      "optional": true
    },
    "@tailwindcss/postcss": {
      "optional": true
    },
    "eslint-plugin-react-x": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/css": "2.0.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^26.0.0",
    "eslint": "^10.11.0",
    "eslint-config-next": "16.2.11",
    "eslint-plugin-react-x": "5.20.8",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "knip": "^6.12.1",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "semgrep",
    "lint",
    "pragmatiks"
  ],
  "license": "MIT",
  "author": "Pragmatiks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragmatiks/pragma-lint.git",
    "directory": "js"
  }
}
